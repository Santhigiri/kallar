# Chandiroor — panchangam data (reads + admin-mutating panchangam/guruvani/settings/event calls)
VITE_APP_BASE_URL=http://localhost:8000

# TVM — auth (login, signup, password reset, profile)
VITE_TVM_BASE_URL=http://localhost:8080

# Build identity — drives the per-env app icon/manifest name (vite.config.ts)
# and the version shown in the sidebar footer (src/lib/version.ts). CI sets
# both automatically from its generated tag; left unset locally, they default
# to "local" / the current git short SHA (or "dev-local").
# One of: local | dev | staging | prod
VITE_APP_ENV=local
VITE_APP_VERSION=
